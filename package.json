{
  "name": "lowcode-materials",
  "private": true,
  "version": "0.0.0",
  "description": "Materials for LowCode",
  "scripts": {
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,scss,md,json}'",
    "update-readme": "node scripts/update-readme.js",
    "build": "pnpm --filter \"./packages/*\" build",
    "clean": "pnpm --filter \"./packages/*\" --parallel clean",
    "typecheck": "pnpm --filter \"./packages/*\" --parallel typecheck",
    "prepublishOnly": "pnpm run build"
  },
  "lint-staged": {
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ],
    "*.{js,jsx,less,scss,md,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "glob": "^13.0.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "authors": [
    {
      "name": "金禅"
    },
    {
      "name": "荣彬"
    },
    {
      "name": "屹凡"
    },
    {
      "name": "启剑"
    },
    {
      "name": "春希"
    },
    {
      "name": "度城"
    },
    {
      "name": "梧忌"
    },
    {
      "name": "莫夭"
    }
  ],
  "license": "MIT"
}
