{
  "name": "@alilc/lce-x6-items",
  "version": "1.0.7",
  "description": "x6-items (AntV X6 图形物料)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./prototype": {
      "import": "./dist/lowcode/meta.mjs",
      "require": "./dist/lowcode/meta.cjs"
    },
    "./prototypeView": {
      "import": "./dist/lowcode/view.mjs",
      "require": "./dist/lowcode/view.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "lowcode",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('lowcode/.entry',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build && pnpm run build:lowcode",
    "build:lowcode": "node ../../scripts/build-lowcode.mjs .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "Fusion",
    "lowcode",
    "x6"
  ],
  "author": "fusion-team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "componentConfig": {
    "isComponentLibrary": true,
    "materialSchema": "https://unpkg.com/@alilc/lce-x6-items@1.0.7/dist/lowcode/assets-prod.json"
  },
  "lcMeta": {
    "type": "component"
  },
  "peerDependencies": {
    "@antv/x6": "^1.35.1",
    "moment": "^2.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@alifd/next": "^1.27.34",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@alilc/lowcode-engine": "workspace:*",
    "@alilc/lowcode-types": "workspace:*",
    "@antv/x6": "^1.35.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "moment": "^2.31.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
