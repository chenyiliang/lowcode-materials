{
  "name": "@alilc/lowcode-materials",
  "version": "1.2.1",
  "description": "Fusion Next for LowCode",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./prototype": {
      "import": "./dist/lowcode/meta.mjs",
      "require": "./dist/lowcode/meta.cjs"
    },
    "./prototypeView": {
      "import": "./dist/lowcode/view.mjs",
      "require": "./dist/lowcode/view.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "lowcode",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('lowcode/.entry',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build && pnpm run build:lowcode && pnpm run build:copy-utils",
    "build:lowcode": "node ../../scripts/build-lowcode.mjs .",
    "build:copy-utils": "node -e \"require('fs').copyFileSync('scripts/utils.js','dist/utils.js')\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "componentConfig": {
    "materialSchema": "https://alifd.alicdn.com/npm/@alilc/lowcode-materials@1.2.1/dist/lowcode/assets-prod.json"
  },
  "license": "MIT",
  "homepage": "https://unpkg.com/@alilc/lowcode-materials@1.2.1/dist/lowcode/assets-prod.json",
  "repository": "https://github.com/alibaba/lowcode-materials.git",
  "lcMeta": {
    "type": "component"
  },
  "authors": [
    { "name": "金禅" },
    { "name": "荣彬" },
    { "name": "屹凡" },
    { "name": "启剑" },
    { "name": "春希" },
    { "name": "度城" },
    { "name": "梧忌" }
  ],
  "peerDependencies": {
    "@alifd/next": "^1.27.34",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "classnames": "^2.5.1",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@alifd/next": "^1.27.34",
    "@alilc/lowcode-types": "workspace:*",
    "@types/big.js": "^7.0.0",
    "@types/lodash": "^4.17.26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
