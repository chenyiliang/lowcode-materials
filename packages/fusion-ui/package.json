{
  "name": "@alifd/fusion-ui",
  "version": "2.1.0",
  "description": "A component library based on Fusion Next",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./prototype": {
      "import": "./dist/lowcode/meta.mjs",
      "require": "./dist/lowcode/meta.cjs"
    },
    "./prototypeView": {
      "import": "./dist/lowcode/view.mjs",
      "require": "./dist/lowcode/view.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "lowcode",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('lowcode/.entry',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build && pnpm run build:lowcode",
    "build:lowcode": "node ../../scripts/build-lowcode.mjs .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "react",
    "component"
  ],
  "license": "MIT",
  "homepage": "https://unpkg.com/@alifd/fusion-ui@2.1.0/dist/lowcode/assets-prod.json",
  "componentConfig": {
    "name": "FusionUI",
    "category": "精品物料库",
    "isComponentLibrary": true,
    "materialSchema": "https://alifd.alicdn.com/npm/@alifd/fusion-ui@2.1.0/dist/lowcode/assets-prod.json"
  },
  "lcMeta": {
    "type": "component"
  },
  "materialConfig": {
    "fusion-site": {
      "id": 1,
      "name": "PC 官网",
      "url": "https://fusion.design/api/v1/sites/1/materials"
    }
  },
  "repository": "https://github.com/alibaba/lowcode-materials.git",
  "peerDependencies": {
    "@alifd/next": "^1.27.34",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@antv/data-set": "^0.11.8",
    "@hello-pangea/dnd": "^18.0.1",
    "@sindresorhus/is": "^8.1.0",
    "ahooks": "^3.10.0",
    "bizcharts": "^4.1.23",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "framer-motion": "^14.3.0",
    "hoist-non-react-statics": "^3.3.2",
    "js-cookie": "^3.0.8",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "numeral": "^2.0.6",
    "numvert": "^0.2.2",
    "qs": "^6.16.1",
    "rc-resize-observer": "^1.4.3",
    "react-sortablejs": "^6.1.4",
    "sortablejs": "^1.15.7",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@alifd/layout": "^2.4.1",
    "@alifd/next": "^1.27.34",
    "@alilc/lowcode-engine": "workspace:*",
    "@alilc/lowcode-types": "workspace:*",
    "@types/hoist-non-react-statics": "^3.3.7",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.26",
    "@types/numeral": "^2.0.5",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
