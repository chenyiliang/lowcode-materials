{
  "name": "@alilc/antd-lowcode-materials",
  "version": "1.2.2",
  "description": "Antd for LowCode",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./prototype": {
      "import": "./dist/lowcode/meta.mjs",
      "require": "./dist/lowcode/meta.cjs"
    },
    "./prototypeView": {
      "import": "./dist/lowcode/view.mjs",
      "require": "./dist/lowcode/view.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "lowcode",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('lowcode/.entry',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build && pnpm run build:lowcode",
    "build:lowcode": "node ../../scripts/build-lowcode.mjs .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "authors": [
    {
      "name": "莫夭"
    },
    {
      "name": "金禅"
    }
  ],
  "license": "MIT",
  "homepage": "https://unpkg.com/@alilc/antd-lowcode-materials@1.2.2/dist/lowcode/assets-prod.json",
  "repository": "https://github.com/alibaba/lowcode-materials.git",
  "componentConfig": {
    "materialSchema": "https://alifd.alicdn.com/npm/@alilc/antd-lowcode-materials@1.2.2/dist/lowcode/assets-prod.json"
  },
  "lcMeta": {
    "type": "component"
  },
  "peerDependencies": {
    "antd": "^6.6.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@alifd/next": "^1.27.34",
    "@alilc/lowcode-types": "workspace:*",
    "@types/lodash": "^4.17.26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "antd": "^6.6.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
